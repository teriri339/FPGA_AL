*/workspace/
*/impl/
*/pnr/
*_Runs/
*.bin
*.bit
*.bit.gz
*.rbt
*.bit.txt
*.gise
*.cfi
*.svf
*.jed
*.flash
*.fse

# 日志 / 报告 / 临时文件
*.log
*.logw
*.rpt
*.timingsummary
*.rout
*.jou
*.tmp
*.bak
.~lock.*
*~

# 波形数据库（体积大）
*.wdb
*.wlf
hw/sim/wave/
hw/sim/work/
hw/sim/modelsim.ini
hw/sim/transcript

# ============================================================
# 通用
# ============================================================
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
.vscode/
.idea/
*.recent_user_depot.ini

# ============================================================
# TangDynasty 运行时产物（每次打开工程都会变，不能入库）
# .lock.f 是 TD 的工程锁文件，CURRENT_VERSION_GUIDE 已明确警告不要上传；
# minidump-*.dmp 是 TD 崩溃转储，单个数百 KB 且含本机内存镜像。
# ============================================================
*.lock.f
minidump-*.dmp
